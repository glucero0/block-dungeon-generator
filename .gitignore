# Byte-compiled / optimized Python files
__pycache__/
*.py[cod]
*$py.class

# Packaging / distribution
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Generated layouts (the CLI's own `-o` output, e.g. `out/ruins.json`)
out/

# Editors / OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local environment / secrets — never commit these
.env
.env.*
*.local
